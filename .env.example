# ───── server-cf (Cloudflare Worker) ─────
# Configured in server-cf/wrangler.toml [vars]:
#   ALLOWED_ORIGINS — comma-separated allowed browser origins (empty = allow all in dev)

# ───── web (web/) ─────
# WebSocket URL of the signalling Worker.
#   local dev: ws://localhost:8787  (run `wrangler dev` in server-cf/)
#   production: wss://<your-worker>.workers.dev
NEXT_PUBLIC_SIGNAL_URL=ws://localhost:8787
# Public origin used to build shareable links and QR codes (falls back to the live origin)
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Optional TURN relay for strict/symmetric NATs (STUN-only works for most networks)
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
