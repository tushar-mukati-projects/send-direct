{
  "name": "send-direct-signaling-cf",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run -c vitest.workers.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "check:fix": "npm run lint -- --fix && npm run format:fix && npm run typecheck",
    "dry-run": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.70",
    "@cloudflare/workers-types": "^4.20250601.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "~3.2.0",
    "wrangler": "^4.0.0"
  }
}
